{
  "name": "climate-sim-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "build:demo": "DEMO_EXPORT=1 npm run build",
    "start": "next start",
    "lint": "eslint",
    "dev:mock": "NEXT_PUBLIC_MOCK_API=1 next dev --turbopack",
    "api:generate": "node scripts/generate-api.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test -c playwright.pages.config.ts",
    "test:e2e:fullstack": "bash scripts/test-e2e-fullstack.sh",
    "format": "prettier --check src scripts tests e2e-fullstack *.ts *.mts *.mjs package.json tsconfig.json README.md CONTRIBUTING.md docker-compose.e2e.yml .github/workflows/{ci,e2e,pages}.yml"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-react": "^1.74.0",
    "maplibre-gl": "^5.24.1",
    "next": "16.4.6",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "^4.10.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fast-png": "^8.0.0",
    "gifenc": "^1.0.3",
    "jsdom": "^31.0.1",
    "mediabunny": "^1.66.0",
    "msw": "^3.0.6",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
